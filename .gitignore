# Secrets: never commit. Copy .env.example to .env locally.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Runtime data (local database and everything customers upload)
claims.db
*.db
uploads/*
!uploads/.gitkeep

# Temporary files from local testing (root and infra/ only, so package files
# like tools/__init__.py are NOT ignored)
/_*
/infra/_*
_shot_profile/

# AWS CDK
infra/.venv/
infra/cdk.out/
infra/cdk.context.json
infra/.origin-secret

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
