# Local environment (loaded by `agentcore dev`; never commit secrets)
.env.local
.env*.local

# Python
__pycache__/
*.py[cod]
.venv/

# Node
node_modules/

# AgentCore CLI state (ignore local scratch like traces/logs, but commit the
# deployed-state binding so a target's stack + credential ARNs are shared)
agentcore/.cli/*
!agentcore/.cli/deployed-state.json

# Copied in by sync_agent_code.py (source of truth is claim-intake-agent/)
app/agent/agentcore_runtime.py
app/agent/agentcore_client.py
app/agent/config.py
app/agent/database.py
app/agent/llm.py
app/agent/policy_rules.py
app/agent/tools/
app/agent/policies/

# AgentCore build cache (CodeZip dependency staging)
agentcore/.cache/

# CDK
agentcore/cdk/cdk.out/
