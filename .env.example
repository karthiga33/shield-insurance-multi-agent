# Copy this file to .env and fill in your values. Never commit .env.

# Which model provider to use: "bedrock" (AWS, default) or "openai".
LLM_PROVIDER=bedrock

# --- AWS Bedrock -----------------------------------------------------------
# Option A: access keys for an IAM user that can call Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Option B: leave the keys blank and set a named profile (e.g. an SSO profile).
# AWS_PROFILE=
AWS_REGION=us-east-1

# Amazon Nova Pro handles text and images and needs no extra access form.
# Leave blank to auto-pick an available Claude model instead.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_VISION_MODEL_ID=us.amazon.nova-pro-v1:0

# --- OpenAI (only used when LLM_PROVIDER=openai) ---------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Admin desk ------------------------------------------------------------
# Passcode for the Admin tab. Defaults to admin123 if unset; change it.
ADMIN_TOKEN=change-me

# Optional: path to the Tesseract binary if it is not found automatically.
# TESSERACT_CMD=
